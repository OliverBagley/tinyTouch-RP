#!/bin/zsh
set -euo pipefail

firmware_dir="${0:A:h}/tiny_touch_unified"
build_dir="$firmware_dir/build"
build_only=false

usage() {
  print "Usage: ./firmware/build-and-flash [--build-only]"
  print
  print "Build the RP2040-Zero factory firmware and optionally copy it to a board in BOOTSEL mode."
}

while (( $# > 0 )); do
  case "$1" in
    --build-only)
      build_only=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      print -u2 "Unknown option: $1"
      usage
      exit 2
      ;;
  esac
done

# Toolchain: PATH first, then the Pico VS Code extension layout, then the Arm cask.
if ! command -v arm-none-eabi-gcc >/dev/null 2>&1; then
  for candidate in $HOME/.pico-sdk/toolchain/*/bin(N/On) /Applications/ArmGNUToolchain/*/arm-none-eabi/bin(N/On); do
    if [[ -x "$candidate/arm-none-eabi-gcc" ]]; then
      export PATH="$candidate:$PATH"
      break
    fi
  done
fi
if ! command -v arm-none-eabi-gcc >/dev/null 2>&1; then
  print -u2 "arm-none-eabi-gcc was not found."
  print -u2 "Install the Arm GNU toolchain (brew install --cask gcc-arm-embedded) or the Raspberry Pi Pico VS Code extension."
  exit 1
fi
command -v cmake >/dev/null 2>&1 || { print -u2 "cmake was not found (brew install cmake)."; exit 1; }

sdk="${PICO_SDK_PATH:-}"
if [[ -z "$sdk" ]]; then
  for candidate in "$HOME/pico-sdk" $HOME/.pico-sdk/sdk/*(N/On); do
    if [[ -f "$candidate/pico_sdk_init.cmake" ]]; then
      sdk="$candidate"
      break
    fi
  done
fi
if [[ ! -f "$sdk/pico_sdk_init.cmake" ]]; then
  print -u2 "Pico SDK 2.x was not found."
  print -u2 "Clone https://github.com/raspberrypi/pico-sdk to ~/pico-sdk or set PICO_SDK_PATH."
  exit 1
fi
if [[ ! -f "$sdk/lib/tinyusb/src/tusb.h" || ! -f "$sdk/lib/mbedtls/library/aes.c" ]]; then
  print -u2 "Pico SDK submodules are missing. Run: git -C $sdk submodule update --init lib/tinyusb lib/mbedtls"
  exit 1
fi

print "Step 1 of 3: Configure"
print "  Pico SDK: $sdk"
print "  Compiler: $(command -v arm-none-eabi-gcc)"
cmake -S "$firmware_dir" -B "$build_dir" -DPICO_SDK_PATH="$sdk" -DCMAKE_BUILD_TYPE=Release >/dev/null
print "  ✓ Configured."

print
print "Step 2 of 3: Build unified factory firmware"
cmake --build "$build_dir" --parallel
print "  ✓ Firmware build completed."
print "  Factory image (UF2): $build_dir/tiny_touch_unified.uf2"
print "  OTA image (signed):  $build_dir/tiny_touch_unified.signed.bin"

if $build_only; then
  print
  print "Build-only mode complete. Nothing was flashed."
  exit 0
fi

print
print "Step 3 of 3: Flash the factory firmware"
volume=/Volumes/RPI-RP2
if [[ ! -d "$volume" ]]; then
  print "  Hold BOOT on the RP2040-Zero while connecting USB, or hold BOOT and tap RESET."
  print "  Waiting for the RPI-RP2 drive..."
  for (( attempt = 0; attempt < 120; attempt++ )); do
    [[ -d "$volume" ]] && break
    sleep 1
  done
fi
[[ -d "$volume" ]] || { print -u2 "The RPI-RP2 drive did not appear."; exit 1; }
cp -X "$build_dir/tiny_touch_unified.uf2" "$volume/"
print "  ✓ Firmware was copied. The board restarts when the drive disappears."
print
print "Factory flash complete."
print "Because the sensor stays powered during an MCU reset, unplug and reconnect USB once now."
print "After reconnecting, customer configuration uses only: tinytouch setup"
