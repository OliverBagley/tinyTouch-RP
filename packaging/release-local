#!/bin/zsh
set -euo pipefail

project_dir="${0:A:h:h}"
cd "$project_dir"

version="$(tr -d '[:space:]' < VERSION)"
tag="v$version"
commit="$(git rev-parse HEAD)"
publish_root="$project_dir/dist/local-publish"

git diff --quiet -- && git diff --cached --quiet -- || {
  print -u2 "Tracked files must be committed before a local production release."
  exit 1
}
git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null && {
  print -u2 "Tag $tag already exists."
  exit 1
}
command -v gh >/dev/null || { print -u2 "GitHub CLI is required."; exit 1; }

started=$SECONDS
packaging/local-deploy
mkdir -p "$publish_root"
cp dist/tinytouch.tar.gz "$publish_root/tinytouch-macos-arm64.tar.gz"

"$project_dir/.venv/bin/python" packaging/attach-cli.py dist/local \
  --arm64 "$publish_root/tinytouch-macos-arm64.tar.gz"
"$project_dir/.venv/bin/python" packaging/release_integrity.py assembled dist/local --commit "$commit"
"$project_dir/.venv/bin/python" packaging/finalize-release.py dist/local \
  --output "$publish_root/assets" --commit "$commit"

git tag -a "$tag" -m "tinyTouch $version"
git push origin "refs/tags/$tag"
gh release create "$tag" "$publish_root/assets/"* \
  --repo ZimengXiong/tinyTouch --verify-tag --generate-notes --draft
gh release edit "$tag" --repo ZimengXiong/tinyTouch --draft=false --latest

print "Published $tag locally in $((SECONDS - started))s."
